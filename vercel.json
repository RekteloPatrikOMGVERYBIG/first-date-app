{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://first-date-app.onrender.com/api/:path*"
    },
    {
      "source": "/owner",
      "destination": "/index.html"
    },
    {
      "source": "/owner/",
      "destination": "/index.html"
    },
    {
      "source": "/invite/:path*",
      "destination": "/index.html"
    }
  ]
}
